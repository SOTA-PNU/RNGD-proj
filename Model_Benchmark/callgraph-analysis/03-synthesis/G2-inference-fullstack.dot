// G2 — INFERENCE request: POST /v1/chat/completions (and /v1/completions stream)
// Full-stack call graph across Python | native(Rust) | kernel(furiosa_rngd) | HW.
// Evidence: Python sites = furiosa_llm source (file:line) + viztracer boundary leaves
// (NativeLLMEngine.generate/stream_generate, tokenizers.Tokenizer.encode_batch).
// Native = RUST_LOG modules + gdb thread taxonomy. Kernel = bpftrace (doorbell_sq x32
// from comm=furiosa-llm during inference, npu_doorbell_handler IRQ x784, PDMA).
// Yellow = Python->native boundary. Orange = native->kernel boundary.
digraph G2 {
  rankdir=LR; compound=true; node [shape=box, fontsize=10, fontname="DejaVu Sans"];
  edge [fontsize=8];

  subgraph cluster_client {
    label="client / kernel net-in"; style=filled; color="#f0f0f0";
    c0 [label="curl POST /v1/chat/completions\n(or /v1/completions stream)"];
    c1 [label="kernel TCP/IP -> epoll\n(socket accept/recv)"];
    c0->c1;
  }

  subgraph cluster_server {
    label="server / Python  (uvloop event loop, thread 'furiosa-llm' main)"; style=filled; color="#eafbea";
    p0 [label="uvloop Loop._run -> uv_run\n(libuv in libtorch_cpu.so)\nepoll_pwait  [gdb: thread 1]"];
    p1 [label="FastAPI route handler\n@app.post('/v1/chat/completions')\nserver/app.py"];
    p2 [label="OpenAIServingChat.create_chat_completion\nserver/serving_chat.py"];
    p3 [label="chat_utils: render chat template\n(content-format 'string')"];
    p4 [label="tokenizers.Tokenizer.encode_batch\n(native HF tokenizer)", style=filled, fillcolor=lightyellow];
    p5 [label="AsyncLLMEngine.generate / LLM\nllm_engine.py:578 / api.py"];
    p6 [label="NativeLLMEngine.stream_generate(prompt_ids, sp)\napi.py:606 / llm_engine.py:611  (native, async gen)", style=filled, fillcolor=lightyellow];
    p0->p1->p2->p3->p4; p2->p5->p6;
  }
  c1->p0 [label="request"];

  subgraph cluster_native {
    label="native runtime (Rust/tokio; gdb: 128 tokio + ~260 'scheduler-eager' threads / 4 DP)"; style=filled; color="#f3eaff";
    m0 [label="next_gen::generator\nenqueue request -> DP route (PrefixAware)"];
    m1 [label="scheduler (Eager loop)\nrequest_management::task_selector\npick AOT pipeline for bucket"];
    m2 [label="scheduler::memory_manager\nKV cache block alloc (block=1024)\nprefix-cache lookup"];
    m3 [label="structured_output (xgrammar / llg_*)\nper-token logit mask (if constrained)"];
    m4 [label="executor: build command descriptors\nsubmit to NPU command ring (per PE)"];
    m5 [label="poll completion ring;\ngather logits; sample next token"];
    m0->m1->m2->m4->m5; m2->m3->m4; m5->m1 [label="decode loop\n(per token)", style=dashed];
  }
  p6->m0 [label="pyo3 -> Rust", lhead=cluster_native];

  subgraph cluster_kernel {
    label="kernel furiosa_rngd (eBPF observed during inference)"; style=filled; color="#ffeaea";
    k0 [label="doorbell_sq_write -> command-ring submit to PE\nengine workers comm=tokio-runtime-w (~6624/window)\n+ main comm=furiosa-llm x32", style=filled, fillcolor="#ffd9b3"];
    k1 [label="NPU executes prefill/decode\non 8 PE (tp8) x 4 DP"];
    k2 [label="npu_doorbell_handler IRQ x16416\n(completion); npu_pdma_dma_transfer_*\n+ dma_wait (kworker) for KV/activations"];
    k3 [label="doorbell_cq_read  x32\n(native reads completion)"];
    k0->k1->k2->k3;
  }
  m4->k0 [label="ioctl/doorbell mmio", ltail=cluster_native, lhead=cluster_kernel];
  k3->m5 [label="completion -> logits", lhead=cluster_native];

  subgraph cluster_hw { label="hardware"; style=filled; color="#f0f0f0";
    h0 [label="RNGD PE array + HBM (KV cache)"]; }
  k1->h0;

  subgraph cluster_resp {
    label="response (per-token, back up the stack)"; style=filled; color="#eef3ff";
    r0 [label="NativeRequestOutput / NativeCompletionOutput\n(native -> Python)", style=filled, fillcolor=lightyellow];
    r1 [label="_generate_postprocess / streaming\nbuild OpenAI delta  serving_chat.py"];
    r2 [label="FastAPI StreamingResponse\n'data: {...}\\n\\n' per token (SSE)"];
    r3 [label="curl receives token stream"];
    r0->r1->r2->r3;
  }
  m5->r0 [label="yield token", ltail=cluster_native];
  r2->p0 [label="write via uvloop", style=dotted];
}
