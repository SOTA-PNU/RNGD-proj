// G1 — `furiosa-llm serve <artifact> --port 12345`  STARTUP / LOAD ("build" at serve time)
// Full-stack call graph across Python | native(Rust, stripped) | kernel(furiosa_rngd) | HW.
// Evidence: Python sites = furiosa_llm source (file:line). Native nodes = RUST_LOG module
// path (native_runtime.so is stripped; module granularity is the resolvable level).
// Kernel nodes = bpftrace kprobe/tracepoint hits with observed counts (Run A/B).
// Yellow = Python->native boundary (pyo3). Orange = native->kernel boundary (syscall/ioctl).
digraph G1 {
  rankdir=LR; compound=true; node [shape=box, fontsize=10, fontname="DejaVu Sans"];
  edge [fontsize=8];

  subgraph cluster_cli {
    label="CLI / process entry"; style=filled; color="#eef3ff";
    a0 [label="furiosa-llm (console_script)"];
    a1 [label="cli.main.main()\ncli/main.py:9"];
    a2 [label="cli.serve.serve(args)\ncli/serve.py:384"];
    a3 [label="server.app.run_server(args)\nserver/app.py:533"];
    a4 [label="uvicorn.run(app)\nserver/app.py:549"];
    a0->a1->a2->a3->a4;
  }

  subgraph cluster_server {
    label="server setup (FastAPI)"; style=filled; color="#eafbea";
    s0 [label="init_app(args)\nserver/app.py:376"];
    s1 [label="LLM(model, devices=None, ...)\nconstruct  api.py:115", style=filled, fillcolor=lightyellow];
    s2 [label="OpenAIServingChat / Completion /\nEmbedding / Responses / Tokenization\napp.py:413-446"];
    s3 [label="FastAPI(lifespan)\napp.py:467  + routes"];
    s0->s1; s0->s2; s0->s3;
  }
  a3->s0 [label="builds app"];

  subgraph cluster_engine {
    label="engine / Python (api.py)"; style=filled; color="#fff7e6";
    e0 [label="LLM.__init__\napi.py:115"];
    e1 [label="LLM._init_from_artifact\napi.py:321"];
    e2 [label="resolve_artifact_path\napi.py:346"];
    e3 [label="NextGenArtifact.load_without_blob\napi.py:349  (native)", style=filled, fillcolor=lightyellow];
    e4 [label="NextGenArtifact.override_with\napi.py:354  (native)", style=filled, fillcolor=lightyellow];
    e5 [label="resolve_devices(devices)\napi.py:352 -> device.py"];
    e6 [label="NativeLLMEngine.__init__(artifact, devices)\napi.py:383  (native)", style=filled, fillcolor=lightyellow];
    e0->e1; e1->e2; e1->e3; e1->e4; e1->e5; e1->e6;
  }
  s1->e0 [label="__init__"];

  subgraph cluster_native {
    label="native runtime  (native_runtime.so, Rust/tokio — STRIPPED; nodes = RUST_LOG module)"; style=filled; color="#f3eaff";
    n0 [label="furiosa::llm::engine\nload artifact (schema 3.0)\nparse cfg: tp=8 pp=1 dp=4"];
    n1 [label="device_runtime::context\nopen devices; start memory-dump\nthread per Device([npu:k:0-3,4-7])"];
    n2 [label="furiosa_generator::next_gen::\nhf_compat_next_gen — load target model"];
    n3 [label="next_gen::pipeline::resolve\nalloc plan: weights 14.2GiB,\nIO 2.0GiB; KV 31.3GiB / device"];
    n4 [label="furiosa_generator::backing_file\nload 14.2GiB params (mmap safetensors)"];
    n5 [label="structured_output::manager\ninit XGrammar + LLGuidance (llg_*)"];
    n6 [label="next_gen::generator\nDpId(0..3) -> npu{0..3}pe0-3,pe4-7"];
    n7 [label="scheduler::task_selector\n(AOT pipelines, jit=off)"];
    n8 [label="scheduler::memory_manager\nKVCacheManager: 585,555 blocks"];
    n9 [label="next_gen::generator\nEager scheduler started x4 DP"];
    n0->n1->n2->n3->n4; n3->n5; n4->n6->n7->n8->n9;
  }
  e6->n0 [label="pyo3 -> Rust", lhead=cluster_native];

  subgraph cluster_kernel {
    label="kernel  furiosa_rngd  (eBPF: kprobe / renegade_pdma tracepoints — observed counts)"; style=filled; color="#ffeaea";
    k0 [label="openat /dev/rngd/npu{0..3}{mgmt,bar0/2/4,\npe0-3,pe4-7,ch0-7,ch*r,dmar,p2pmem}", style=filled, fillcolor="#ffd9b3"];
    k1 [label="npu_pdma_open  x72\nnpu_dmar_ncdev_open  x8\nnpu_bar_ncdev_open"];
    k2 [label="npu_mgmt_admin_cmd  x820\n(firmware init/config; tokio-runtime-w)"];
    k3 [label="npu_dmar_ncdev_ioctl  x16\ncmd 0xC0046706 / 0xC0C0..  (PE-group setup)"];
    k4 [label="weight-load DMA:\ndoorbell_sq_write -> npu_dma_transfer_start\n~8000x (kworker/u515) ; npu_doorbell_handler IRQ"];
    k0->k1->k2->k3->k4;
  }
  n1->k0 [label="open()", ltail=cluster_native, lhead=cluster_kernel];
  n1->k2 [label="ioctl()"];
  n4->k4 [label="DMA weights -> HBM"];

  subgraph cluster_hw {
    label="hardware"; style=filled; color="#f0f0f0";
    h0 [label="4x RNGD NPU\n8 PE/card (pe0-3 + pe4-7 fused)\nHBM: 14.2GiB weights + 31.3GiB KV / card"];
  }
  k4->h0 [label="PCIe BAR / DMA"];
}
