#!/usr/bin/env bpftrace
/*
 * kernel_trace.bt — furiosa_rngd (RNGD NPU) kernel-layer call/event trace
 * Captures the user->syscall->driver boundary for `furiosa-llm serve`:
 *   - NPU char-device opens (bar/mgmt/pe, dmar, pdma channels)
 *   - ioctl command path (bar ncdev, dmar ncdev), firmware admin commands
 *   - BAR/DMA mmap
 *   - PDMA data movement (weight load + per-token KV/activation DMA) via the
 *     driver's own renegade_pdma tracepoints
 *   - doorbell submit/complete + DMA ISR (command ring / completion)
 * Structural (low-freq) events are printed in order; high-freq DMA/doorbell
 * events are counted by comm. Run as root.
 */
BEGIN { printf("KTRACE_START nsec=%llu\n", nsecs); }

/* ---------- device opens (structural) ---------- */
kprobe:npu_bar_ncdev_open    { printf("%llu OPEN  bar          comm=%s pid=%d tid=%d\n", nsecs, comm, pid, tid); @opens["bar"]=count(); }
kprobe:npu_dmar_ncdev_open   { printf("%llu OPEN  dmar         comm=%s pid=%d tid=%d\n", nsecs, comm, pid, tid); @opens["dmar"]=count(); }
tracepoint:renegade_pdma:npu_pdma_open        { printf("%llu OPEN  pdma         comm=%s pid=%d tid=%d\n", nsecs, comm, pid, tid); @opens["pdma"]=count(); }
tracepoint:renegade_pdma:npu_pdma_remote_open { printf("%llu OPEN  pdma_remote  comm=%s pid=%d tid=%d\n", nsecs, comm, pid, tid); @opens["pdma_remote"]=count(); }

/* ---------- ioctl command path (structural) ---------- */
kprobe:npu_bar_ncdev_ioctl   { printf("%llu IOCTL bar  cmd=0x%lx  comm=%s pid=%d tid=%d\n", nsecs, arg1, comm, pid, tid); @ioctl_bar[arg1]=count(); }
kprobe:npu_dmar_ncdev_ioctl  { printf("%llu IOCTL dmar cmd=0x%lx  comm=%s pid=%d tid=%d\n", nsecs, arg1, comm, pid, tid); @ioctl_dmar[arg1]=count(); }
kprobe:npu_mgmt_admin_cmd    { printf("%llu MGMT_ADMIN_CMD          comm=%s pid=%d tid=%d\n", nsecs, comm, pid, tid); @mgmt_admin=count(); }

/* ---------- mmap (BAR registers / DMA buffers) ---------- */
kprobe:npu_bar_ncdev_mmap    { printf("%llu MMAP  bar          comm=%s pid=%d tid=%d\n", nsecs, comm, pid, tid); @mmap_bar=count(); }

/* ---------- PDMA data movement (high-freq: count by comm) ---------- */
tracepoint:renegade_pdma:npu_pdma_dma_transfer_sync_start  { @dma_sync[comm]=count(); }
tracepoint:renegade_pdma:npu_pdma_dma_transfer_async_start { @dma_async[comm]=count(); }
tracepoint:renegade_pdma:npu_pdma_prepare_request_start    { @dma_prepare[comm]=count(); }
tracepoint:renegade_pdma:npu_pdma_wait_request_start       { @dma_wait[comm]=count(); }
tracepoint:renegade_pdma:npu_pdma_direct_io_start          { @dma_directio[comm]=count(); }
tracepoint:renegade_pdma:npu_pdma_iopoll                   { @dma_iopoll[comm]=count(); }

/* ---------- doorbell / command ring / completion ---------- */
kprobe:doorbell_sq_write     { @doorbell_sq[comm]=count(); }
kprobe:doorbell_cq_read      { @doorbell_cq[comm]=count(); }
kprobe:npu_dma_transfer_start { @dma_xfer_start[comm]=count(); }
kprobe:npu_doorbell_handler  { @doorbell_irq=count(); }
kprobe:npu_dma_isr           { @dma_isr=count(); }

interval:s:5 { printf("---- KTRACE heartbeat nsec=%llu ----\n", nsecs); }

END {
  printf("KTRACE_END nsec=%llu\n", nsecs);
  printf("== device opens ==\n");           print(@opens);
  printf("== ioctl bar  (by cmd) ==\n");     print(@ioctl_bar);
  printf("== ioctl dmar (by cmd) ==\n");     print(@ioctl_dmar);
  printf("== mgmt admin cmd count ==\n");    print(@mgmt_admin);
  printf("== bar mmap count ==\n");          print(@mmap_bar);
  printf("== pdma dma_sync  (by comm) ==\n");  print(@dma_sync);
  printf("== pdma dma_async (by comm) ==\n");  print(@dma_async);
  printf("== pdma prepare_request ==\n");    print(@dma_prepare);
  printf("== pdma wait_request ==\n");       print(@dma_wait);
  printf("== pdma direct_io ==\n");          print(@dma_directio);
  printf("== pdma iopoll ==\n");             print(@dma_iopoll);
  printf("== doorbell sq_write ==\n");       print(@doorbell_sq);
  printf("== doorbell cq_read ==\n");        print(@doorbell_cq);
  printf("== dma_transfer_start ==\n");      print(@dma_xfer_start);
  printf("== doorbell IRQ handler ==\n");    print(@doorbell_irq);
  printf("== dma ISR ==\n");                 print(@dma_isr);
}
