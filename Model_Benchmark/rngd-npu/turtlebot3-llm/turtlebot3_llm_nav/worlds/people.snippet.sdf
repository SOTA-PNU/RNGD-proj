<!-- people.snippet.sdf
     Gazebo Harmonic <actor> 사람 3명. turtlebot3_world.world 의 </world> 바로 위에 붙여 넣으세요.
     skin/animation 메시는 Gazebo 기본 'Walk.dae'(gz-sim 기본 리소스)를 씁니다 — 별도 설치 없이
     대부분 동작합니다. 못 찾으면 GZ_SIM_RESOURCE_PATH 의 사람 메시로 <filename> 을 바꾸세요.
     좌표(x,y)는 로봇 스폰(turtlebot3_world.launch.py 기본 -2.0,-0.5) 앞 화각 안에 두었습니다.
     ground_truth 검출기의 /people_ground_truth JSON 좌표를 이 actor 좌표와 일치시키세요.

     p1: 빨간 셔츠(목표 예시), p2: 파란 셔츠, p3: 초록 셔츠. -->

<actor name="person_red">
  <pose>1.0 0.0 0.0 0 0 3.14159</pose>
  <skin>
    <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
    <scale>1.0</scale>
  </skin>
  <animation name="walk">
    <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
    <scale>1.0</scale>
    <interpolate_x>true</interpolate_x>
  </animation>
  <!-- 정지(가만히 서 있게) : script 없이 pose 고정. 움직이게 하려면 <script><trajectory> 추가. -->
</actor>

<actor name="person_blue">
  <pose>2.0 1.5 0.0 0 0 -1.5708</pose>
  <skin>
    <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
    <scale>1.0</scale>
  </skin>
  <animation name="walk">
    <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
    <scale>1.0</scale>
    <interpolate_x>true</interpolate_x>
  </animation>
</actor>

<actor name="person_green">
  <pose>0.5 -1.8 0.0 0 0 1.5708</pose>
  <skin>
    <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
    <scale>1.0</scale>
  </skin>
  <animation name="walk">
    <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
    <scale>1.0</scale>
    <interpolate_x>true</interpolate_x>
  </animation>
</actor>
