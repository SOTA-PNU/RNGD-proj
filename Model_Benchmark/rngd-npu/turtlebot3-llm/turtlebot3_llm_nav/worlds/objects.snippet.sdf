<!-- objects.snippet.sdf — '집 안 물건 확인' 미션용 물건 모형(작은 색 박스)들.
     turtlebot3_house.world 의 </world> 바로 위에 <model> 들을 붙여 넣으면 집 안에 물건이 놓입니다.
     좌표는 house 네이티브(원점=집 중앙). 진짜 목표는 red cup 하나, 나머지는 헷갈리게 둔 decoy 입니다.
     (색은 시각용; ground_truth 검출기는 /objects_ground_truth 의 features 로 라벨/색을 판정합니다.) -->

<!-- ▼ 진짜 목표: 빨간 컵 (집 안쪽 방에 둠 — 끝까지 검색해야 발견) -->
<model name="cup_red">
  <static>true</static>
  <pose>-5.0 -2.0 0.1 0 0 0</pose>
  <link name="link">
    <visual name="v">
      <geometry><box><size>0.12 0.12 0.15</size></box></geometry>
      <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
    </visual>
    <collision name="c">
      <geometry><box><size>0.12 0.12 0.15</size></box></geometry>
    </collision>
  </link>
</model>

<!-- ▼ decoy 1: 빨간 '책'(색만 같음, 라벨 다름) — 색만 보고 가면 오판 -->
<model name="book_red">
  <static>true</static>
  <pose>2.5 1.5 0.1 0 0 0</pose>
  <link name="link">
    <visual name="v">
      <geometry><box><size>0.2 0.03 0.25</size></box></geometry>
      <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
    </visual>
    <collision name="c">
      <geometry><box><size>0.2 0.03 0.25</size></box></geometry>
    </collision>
  </link>
</model>

<!-- ▼ decoy 2: 파란 '컵'(라벨만 같음, 색 다름) -->
<model name="cup_blue">
  <static>true</static>
  <pose>0.5 -3.0 0.1 0 0 0</pose>
  <link name="link">
    <visual name="v">
      <geometry><box><size>0.12 0.12 0.15</size></box></geometry>
      <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
    </visual>
    <collision name="c">
      <geometry><box><size>0.12 0.12 0.15</size></box></geometry>
    </collision>
  </link>
</model>
