From b011b77eefa02e916e60392a3967cd48b532c531 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 22 Jul 2026 14:19:21 +0900
Subject: [PATCH 02/12] model picker: use backend-supplied model descriptions
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

openclaude labels every discovered model 'Detected from <route>', which says
nothing about how a self-hosted backend will actually serve it. The OpenAI
/v1/models contract has no description field, so the Furiosa setup reads the
router's /router/models at install time and the furio wrapper passes the map in
via FURIO_MODEL_DESCRIPTIONS; the picker now shows e.g. 'tp8·dp2·pp1 · 2장 ·
ctx 40k · fxb'. Falls back to the old text when unset, and ignores malformed
JSON so a bad env var cannot break discovery.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 src/services/api/bootstrap.ts | 35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/src/services/api/bootstrap.ts b/src/services/api/bootstrap.ts
index e901799..9bfec8b 100644
--- a/src/services/api/bootstrap.ts
+++ b/src/services/api/bootstrap.ts
@@ -95,12 +95,40 @@ export function getDiscoveredModelApiNames(
   return discoveredModels?.length ? discoveredModels : null
 }
 
+/**
+ * Per-model descriptions supplied by the backend, as `{"<model id>": "<text>"}`.
+ *
+ * The OpenAI `/v1/models` contract has no description field, so a self-hosted
+ * router cannot tell us how it will serve a model. The Furiosa setup fills this
+ * in at install time (`install.sh` reads the router's `/router/models`) and the
+ * `furio` wrapper passes it through, which means the text is available on the
+ * very first run rather than after a background refresh.
+ *
+ * Malformed JSON is ignored — a bad env var must not break model discovery.
+ */
+function getBackendModelDescriptions(): Record<string, string> {
+  const raw = process.env.FURIO_MODEL_DESCRIPTIONS
+  if (!raw) return {}
+  try {
+    const parsed = JSON.parse(raw) as unknown
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return {}
+    const out: Record<string, string> = {}
+    for (const [k, v] of Object.entries(parsed as Record<string, unknown>)) {
+      if (typeof v === 'string' && v.length > 0) out[k] = v
+    }
+    return out
+  } catch {
+    return {}
+  }
+}
+
 function buildLocalOpenAIModelOptions(options: {
   models: string[]
   routeId: string | null
   routeLabel: string
 }): ModelOption[] {
   const seen = new Set<string>()
+  const backendDescriptions = getBackendModelDescriptions()
   const catalogEntries = options.routeId
     ? getCatalogEntriesForRoute(options.routeId)
     : []
@@ -125,7 +153,12 @@ function buildLocalOpenAIModelOptions(options: {
     return [{
       value,
       label: catalogEntry?.label ?? model,
-      description: `Detected from ${options.routeLabel}`,
+      // Prefer what the backend says about this model (e.g. "tp8·dp2·pp1 · 2장")
+      // over the generic provenance line.
+      description:
+        backendDescriptions[value] ??
+        backendDescriptions[model] ??
+        `Detected from ${options.routeLabel}`,
     }]
   })
 }
