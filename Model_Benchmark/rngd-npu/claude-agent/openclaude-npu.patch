+ * router's `/router/models` at install time and the `furio` wrapper passes the
+ * map in, which means the text is available on the very first run rather than
+ * after a background refresh. Malformed JSON is ignored — a bad env var must
+ * not break model discovery.
+ */
+export function getBackendModelDescriptions(): Record<string, string> {
+  const raw = process.env.FURIO_MODEL_DESCRIPTIONS
+  if (!raw) return {}
+  try {
+    const parsed = JSON.parse(raw) as unknown
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return {}
+    const out: Record<string, string> = {}
+    for (const [k, v] of Object.entries(parsed as Record<string, unknown>)) {
+      if (typeof v === 'string' && v.length > 0) out[k] = v
+    }
+    return out
+  } catch {
+    return {}
+  }
