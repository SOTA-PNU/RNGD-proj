+
+/**
+ * Presents a backend option list the way a person chooses: one row per model,
+ * described by how it will actually be served.
+ *
+ * Applied at the single point where every picker path converges, because the
+ * `/model` command supplies its own `optionsOverride` and therefore bypasses
+ * `getModelOptions()` entirely — fixing only the latter leaves the list
+ * untouched.
+ */
+export function applyNpuPresentation<
+  T extends { value?: string | null; description?: string },
+>(options: readonly T[]): T[] {
+  const descriptions = getBackendModelDescriptions()
+  const values = options
+    .map(o => o.value)
+    .filter((v): v is string => typeof v === 'string')
+  const kept = new Set(collapseNpuVariants(values))
+  return options
+    .filter(o => typeof o.value !== 'string' || kept.has(o.value))
+    .map(o => {
+      const described =
+        typeof o.value === 'string' ? descriptions[o.value] : undefined
+      return described ? { ...o, description: described } : o
+    })
+}
