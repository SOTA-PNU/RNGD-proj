+/**
+ * One status segment per model the NPU router knows about, plus the model the
+ * user has selected even when it is not loaded yet (shown red) — otherwise
+ * picking a cold model would show nothing at all until it finishes loading.
+ *
+ * `currentModelId` is marked with `▶` so it stays identifiable once several
+ * models share the four cards.
+ */
+export function buildNpuSegments(npu: NpuStatus, currentModelId: string | null): StatusSegment[] {
+  if (!npu.available) return [];
+  const segments: StatusSegment[] = [];
+  const seen = new Set<string>();
+  const blinkOn = npu.phase % 2 === 0;
+
+  const push = (m: NpuModel, isCurrent: boolean) => {
+    seen.add(m.id);
+    const transitioning = m.state === 'loading' || m.state === 'stopping';
+    const glyph = transitioning ? (blinkOn ? LED_ON : LED_OFF) : LED_ON;
+    const color: keyof Theme | undefined =
+      m.state === 'up' ? 'success'
+      : transitioning ? 'warning'
+      : 'error';
+    const where = m.cards.length > 0 ? ` npu${m.cards.join(',')}` : '';
+    segments.push({
+      key: `npu:${m.id}`,
+      // Current model outranks context/cost so it survives a narrow terminal;
+      // the other cards' models yield first.
+      priority: isCurrent ? 0.5 : 4,
+      text: `${isCurrent ? '▶' : ''}${glyph} ${m.id}${where}`,
+      shortText: `${isCurrent ? '▶' : ''}${glyph} ${m.id}`,
+      color,
+    });
+  };
+
+  const current = currentModelId ? npu.models.find(m => m.id === currentModelId) : undefined;
+  if (current) {
