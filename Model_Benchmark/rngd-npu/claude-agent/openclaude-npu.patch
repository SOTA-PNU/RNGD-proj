+/**
+ * One status segment per model the NPU router knows about, plus the model the
+ * user has selected even when it is not loaded yet (shown red) — otherwise
+ * picking a cold model would show nothing at all until it finishes loading.
+ *
+ * `currentModelId` is marked with `▶` so it stays identifiable once several
+ * models share the four cards.
+ */
+export function buildNpuSegments(npu: NpuStatus, currentModelId: string | null): StatusSegment[] {
+  if (!npu.available) return [];
+  const segments: StatusSegment[] = [];
+  const seen = new Set<string>();
+  const blinkOn = npu.phase % 2 === 0;
