+/**
+ * NPU parallelism variants.
+ *
+ * The Furiosa router publishes one model id per usable parallel configuration —
+ * `Qwen3-4B-FP8`, `Qwen3-4B-FP8@dp2`, `Llama-3.1-8B-Instruct@dp2@pp2` — because
+ * the OpenAI `/v1/models` contract has nowhere else to put them. It only
+ * publishes combinations the hardware can actually serve: tensor parallelism is
+ * fixed at artifact build time, pipeline parallelism is unsupported for FXB
+ * artifacts, and dp x pp is capped by the card count.
+ *
+ * Grouping them back together lets the model picker present one model with an
+ * adjustable configuration instead of five near-identical rows.
+ */
+
+export type NpuVariant = {
+  /** Full model id including the suffix, e.g. `Qwen3-4B-FP8@dp2`. */
+  value: string
+  /** Model id without any parallelism suffix. */
+  base: string
+  dp: number
+  pp: number
+}
+
+const SUFFIX = /@(dp|pp)(\d+)$/
+
+/** Splits a model id into its base and parallel configuration. */
+export function parseNpuVariant(value: string): NpuVariant {
+  let rest = value
+  let dp = 1
+  let pp = 1
+  for (;;) {
+    const m = SUFFIX.exec(rest)
+    if (!m) break
+    const n = Number(m[2])
+    // A malformed suffix is left as part of the base rather than silently
+    // dropped — better to show an odd name than to route to the wrong model.
+    if (!Number.isFinite(n) || n < 1) break
+    if (m[1] === 'dp') dp = n
+    else pp = n
+    rest = rest.slice(0, m.index)
+  }
+  return { value, base: rest, dp, pp }
+}
+
+/** Cards a configuration occupies, given how many the base model needs. */
+export function variantCards(v: NpuVariant, baseCards: number): number {
+  return baseCards * v.dp * v.pp
+}
+
+/**
+ * All configurations of `value`'s model among `allValues`, ordered by card
+ * usage so cycling moves smoothly from cheapest to widest. Always contains at
+ * least the input value.
+ */
+export function npuVariantsOf(value: string, allValues: readonly string[]): NpuVariant[] {
+  const { base } = parseNpuVariant(value)
+  const found = allValues
+    .map(parseNpuVariant)
+    .filter(v => v.base === base)
+  if (found.length === 0) return [parseNpuVariant(value)]
+  found.sort((a, b) => a.dp * a.pp - b.dp * b.pp || a.value.localeCompare(b.value))
+  return found
+}
+
+/**
+ * Next configuration in the given direction, wrapping around. Returns null when
+ * the model has only one configuration, so callers can leave the keypress
+ * unhandled rather than pretending something changed.
+ */
+export function cycleNpuVariant(
+  value: string,
+  allValues: readonly string[],
+  direction: 'left' | 'right',
+): string | null {
+  const variants = npuVariantsOf(value, allValues)
+  if (variants.length < 2) return null
+  const i = variants.findIndex(v => v.value === value)
+  if (i === -1) return null
+  const next = direction === 'right' ? (i + 1) % variants.length : (i - 1 + variants.length) % variants.length
+  return variants[next]!.value
+}
+
+/** Short label for the status row, e.g. `dp2·pp1` or `dp1·pp1 (기본)`. */
+export function describeNpuVariant(v: NpuVariant): string {
+  return `dp${v.dp}·pp${v.pp}`
+}
